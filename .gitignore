# --- Python & General ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.env
mise.local.toml

# --- OS ---
.DS_Store
._*
Thumbs.db
desktop.ini

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo

# --- Office documents ---
# The article is kept outside version control (backed up separately); only the
# data and scripts behind its results live here, under docs/experiments/.
*.docx
*.pdf
# Lock files Word and LibreOffice create while a document is open
~$*
.~lock.*#

# --- PureFlow-Arch Project Specific ---

# 1. Data Storage (MinIO / S3 Simulated)
# Everything under data/ is runtime state; .gitkeep preserves the directory
data/*
!data/.gitkeep

# 2. Processing Engine (DuckDB)
*.db
*.db.wal
*.duckdb
*.duckdb.wal

# 3. Transformation Layer (dbt)
# profiles.yml is tracked on purpose: the container reads it from dbt/
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
target/
dbt_packages/

# 4. Orchestration Layer (Dagster)
# Run history and logs are runtime state; dagster.yaml is the instance config
dagster_home/*
!dagster_home/dagster.yaml
.dagster/
storage/
*.tmp
*~

# 5. Quality & Validation (Great Expectations)
# Generated data docs and validation results
gx/uncommitted/
gx/logs/
# Suite JSONs are OUTPUT, not source: the expectations are declared in
# src/core/gates.py and validate_data() wipes and rebuilds each suite from that
# list on every call. Keeping them tracked meant every pipeline run dirtied the
# worktree with regenerated files nothing reads.
gx/expectations/*.json
# validation_definitions are created and deleted per-run by gx_validator.py and are
# never meant to persist between runs, let alone be committed.
gx/validation_definitions/
