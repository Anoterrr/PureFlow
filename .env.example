# --- Storage Configuration (MinIO / S3) ---
STORAGE_USER=admin
STORAGE_PASSWORD=strongpassword123
S3_ENDPOINT=http://127.0.0.1:9000

# --- Processing Configuration (DuckDB) ---
# DUCKDB_PATH: every dbt/DuckDB session is ephemeral (":memory:") by default —
# required so concurrent runs never contend for a shared lock file. Only set
# this to a real path for local, single-session debugging with a persistent
# catalog to inspect afterwards.
# DUCKDB_PATH=data/pureflow_lakehouse.db
# Resource limits: lower these if running on a machine with limited RAM
# (e.g. Docker Desktop on Mac, which allocates less RAM to its VM by default)
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=2

# --- Pipeline & Date Configuration ---
# Both default to today (resolved at run time) when left unset — no fixed
# date is required. Set one of these only to pin a specific partition, e.g.
# to reproduce a past run or backfill a historical date.
# BASE_DATE: static config fallback (scripts/tests run outside Dagster)
# BASE_DATE=2026-04-19
# EXECUTION_DATE: dbt override, used only when compiling/generating docs
# outside of a Dagster run (Dagster runs and the dashboard resolve their own
# date dynamically and ignore this)
# EXECUTION_DATE=2026-04-19

# --- S3 Bucket Names (Medallion Architecture) ---
S3_BUCKET_LANDING=landing-zone
S3_BUCKET_BRONZE=bronze
S3_BUCKET_SILVER=silver
S3_BUCKET_GOLD=gold
S3_BUCKET_QUARANTINE=quarantine
