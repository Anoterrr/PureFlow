# --- Storage (S3, served by SeaweedFS) ---
STORAGE_USER=admin
STORAGE_PASSWORD=strongpassword123
S3_ENDPOINT=http://127.0.0.1:18900

# --- DuckDB ---
# Sessions are in-memory by default so concurrent runs never share a lock file.
# Set a path only for single-session local debugging.
# DUCKDB_PATH=data/pureflow_lakehouse.db
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=2

# --- Partition date ---
PIPELINE_TIMEZONE=UTC
# Both default to today. Set one only to reproduce or backfill a specific date.
# BASE_DATE: used by scripts and tests outside Dagster.
# BASE_DATE=2026-04-19
# EXECUTION_DATE: used by dbt when run outside Dagster (e.g. docs generation).
# EXECUTION_DATE=2026-04-19

# --- Buckets ---
S3_BUCKET_LANDING=landing-zone
S3_BUCKET_BRONZE=bronze
S3_BUCKET_SILVER=silver
S3_BUCKET_GOLD=gold
